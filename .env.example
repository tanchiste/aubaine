# Base de données (Supabase : Project Settings > Database > Connection string, mode "Transaction" port 6543)
DATABASE_URL=postgres://aubaine:aubaine@localhost:5432/aubaine

# Secret pour signer les codes de connexion (générer avec : openssl rand -hex 32)
AUTH_SECRET=change-moi

# Emails autorisés à ouvrir le back-office, séparés par des virgules
ADMIN_EMAILS=toi@exemple.be

# Envoi des codes de connexion (resend.com). Sans clé, le code s'affiche dans la console (développement seulement).
RESEND_API_KEY=
EMAIL_FROM=Aubaine <bonjour@aubaine.be>

# URL publique de l'app
APP_URL=http://localhost:3000
